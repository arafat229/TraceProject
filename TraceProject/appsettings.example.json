{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.LifeTime": "Information"
      }
    }
  },
  // Secrets are NOT stored here. Set them with User Secrets (Development) or environment variables:
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=TraceProject;Username=postgres;Password=..."
  //   dotnet user-secrets set "AppSettings:Token" "<long random string>"
  //   dotnet user-secrets set "Camera:Username" "..."
  //   dotnet user-secrets set "Camera:Password" "..."

  "AppSettings": {
    "Issuer": "https://localhost:7209",
    "Audience": "https://localhost:7209"
  },

  "Camera": {
    "Id": 1,
    "Name": "Main Entrance Camera",
    "IpAddress": "192.168.1.10",
    "RtspUrl": "rtsp://{username}:{password}@192.168.1.10:554/",
    "Transport": "TCP",
    "Enabled": true
    // "LocationId": 1   (optional; otherwise the Cameras row location, then the first location)
  },

  "VideoProcessing": {
    "MaxBufferedFrames": 1,
    "DropOldFrames": true,
    "FrameTimeoutMs": 0,
    "MetricsSummaryIntervalSeconds": 10,
    "TargetProcessingFps": 5,
    "ProcessingWidth": 640,
    "ProcessingHeight": 360
  },

  "Connection": {
    "ReconnectDelaySeconds": 5,
    "MaxReconnectDelaySeconds": 30,
    "BackoffMultiplier": 2.0,
    "MaxReconnectAttempts": 0,
    "ConnectTimeoutMs": 10000
  },

  "FaceDetection": {
    "ModelPath": "Models/FaceDetection/face_detection_yunet_2023mar.onnx",
    "ConfidenceThreshold": 0.6
  },

  "FaceRecognition": {
    "ModelPath": "Models/FaceRecognition/face_recognition_sface_2021dec.onnx",
    "SimilarityThreshold": 0.363,
    "EmbeddingCacheRefreshSeconds": 60,
    "MaxEmbeddingsPerEmployee": 0
  },

  // Desktop monitoring agent (TraceAgent). The agent downloads the first three from /api/Agent/me.
  "ActivityMonitoring": {
    "IdleThresholdSeconds": 300,
    "ReportIntervalSeconds": 15,
    "CaptureWindowTitles": true,
    "OfflineAfterSeconds": 90,
    "PairingCodeMinutes": 15
  },

  // Frontend origins allowed by CORS
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "AllowedHosts": "*"
}
